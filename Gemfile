source "https://rubygems.org"

# The github-pages gem pins Jekyll and every plugin to the exact versions
# GitHub Pages uses, so what you see locally is what gets deployed.
gem "github-pages", group: :jekyll_plugins

# Needed to run `jekyll serve` on Ruby 3.x
gem "webrick", "~> 1.8"

# Ruby 3.4+ moved these out of the default gems; harmless on older Rubies.
gem "csv"
gem "base64"
gem "bigdecimal"
